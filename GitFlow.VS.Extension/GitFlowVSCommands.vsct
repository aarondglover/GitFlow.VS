      <Button guid="guidGitFlowVSCommandSet" id="cmdidFinishRelease" priority="0x0105" type="Button">
        <Parent guid="guidGitFlowVSCommandSet" id="GitFlowSubMenuGroup" />
        <Strings>
          <ButtonText>Finish Release...</ButtonText>
