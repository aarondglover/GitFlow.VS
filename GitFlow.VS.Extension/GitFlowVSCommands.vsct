      <Button guid="guidGitFlowVSCommandSet" id="cmdidStartHotfix" priority="0x0106" type="Button">
        <Parent guid="guidGitFlowVSCommandSet" id="GitFlowSubMenuGroup" />
        <Strings>
          <ButtonText>Start Hotfix...</ButtonText>
