<UserControl x:Class="GitFlowVS.Extension.GitFlowToolWindowControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vsshell="clr-namespace:Microsoft.VisualStudio.Shell;assembly=Microsoft.VisualStudio.Shell.15.0"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="400"
             Background="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowBackgroundKey}}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header with current branch info -->
        <Border Grid.Row="0" Background="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowBackgroundKey}}" 
                Padding="10" BorderBrush="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowBorderKey}}" 
                BorderThickness="0,0,0,1">
            <StackPanel>
                <TextBlock Text="GitFlow for Visual Studio" FontSize="16" FontWeight="Bold" 
                          Foreground="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowTextKey}}" Margin="0,0,0,5"/>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Current Branch: " 
                              Foreground="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowTextKey}}"/>
                    <TextBlock x:Name="CurrentBranchText" Text="(loading...)" FontWeight="Bold" 
                              Foreground="{DynamicResource {x:Static vsshell:VsBrushes.CommandBarTextActiveKey}}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Tabbed content area -->
        <TabControl Grid.Row="1" x:Name="MainTabs" 
                    Background="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowBackgroundKey}}"
                    BorderThickness="0">
            <!-- Workflow Tab -->
            <TabItem Header="Workflow">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10">
                        <!-- Quick Actions Panel -->
                        <GroupBox Header="Quick Actions" Margin="0,0,0,15">
                            <StackPanel Margin="10">
                                <Button x:Name="InitButton" Content="Initialize GitFlow" Height="30" Margin="0,0,0,5" Click="InitButton_Click"/>
                                <Separator Margin="0,10"/>
                                <TextBlock Text="Features:" FontWeight="Bold" Margin="0,0,0,5"/>
                                <Button x:Name="StartFeatureButton" Content="Start Feature" Height="30" Margin="0,0,0,5" Click="StartFeatureButton_Click"/>
                                <Button x:Name="FinishFeatureButton" Content="Finish Feature" Height="30" Margin="0,0,0,10" Click="FinishFeatureButton_Click"/>
                                <TextBlock Text="Releases:" FontWeight="Bold" Margin="0,0,0,5"/>
                                <Button x:Name="StartReleaseButton" Content="Start Release" Height="30" Margin="0,0,0,5" Click="StartReleaseButton_Click"/>
                                <Button x:Name="FinishReleaseButton" Content="Finish Release" Height="30" Margin="0,0,0,10" Click="FinishReleaseButton_Click"/>
                                <TextBlock Text="Hotfixes:" FontWeight="Bold" Margin="0,0,0,5"/>
                                <Button x:Name="StartHotfixButton" Content="Start Hotfix" Height="30" Margin="0,0,0,5" Click="StartHotfixButton_Click"/>
                                <Button x:Name="FinishHotfixButton" Content="Finish Hotfix" Height="30" Margin="0,0,0,0" Click="FinishHotfixButton_Click"/>
                            </StackPanel>
                        </GroupBox>

                        <!-- Status Panel -->
                        <GroupBox Header="Repository Status" Margin="0,0,0,0">
                            <StackPanel x:Name="StatusContent" Margin="10">
                                <!-- Content will be loaded dynamically -->
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Settings Tab -->
            <TabItem Header="Settings">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10">
                        <TextBlock Text="GitFlow Configuration" FontSize="14" FontWeight="Bold" Margin="0,0,0,10"/>
                        <TextBlock Text="Settings are stored per-repository in .git/config" 
                                   FontStyle="Italic" Margin="0,0,0,15" TextWrapping="Wrap"
                                   Foreground="{DynamicResource {x:Static vsshell:VsBrushes.GrayTextKey}}"/>
                        
                        <GroupBox Header="Branch Names" Margin="0,0,0,15">
                            <Grid Margin="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Production branch:" VerticalAlignment="Center" Margin="0,0,0,10"/>
                                <TextBox Grid.Row="0" Grid.Column="1" x:Name="SettingsMasterBranch" Margin="0,0,0,10" Padding="3" IsReadOnly="True"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Development branch:" VerticalAlignment="Center"/>
                                <TextBox Grid.Row="1" Grid.Column="1" x:Name="SettingsDevelopBranch" Padding="3" IsReadOnly="True"/>
                            </Grid>
                        </GroupBox>

                        <GroupBox Header="Branch Prefixes" Margin="0,0,0,15">
                            <Grid Margin="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Feature prefix:" VerticalAlignment="Center" Margin="0,0,0,10"/>
                                <TextBox Grid.Row="0" Grid.Column="1" x:Name="SettingsFeaturePrefix" Margin="0,0,0,10" Padding="3" IsReadOnly="True"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Release prefix:" VerticalAlignment="Center" Margin="0,0,0,10"/>
                                <TextBox Grid.Row="1" Grid.Column="1" x:Name="SettingsReleasePrefix" Margin="0,0,0,10" Padding="3" IsReadOnly="True"/>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Hotfix prefix:" VerticalAlignment="Center" Margin="0,0,0,10"/>
                                <TextBox Grid.Row="2" Grid.Column="1" x:Name="SettingsHotfixPrefix" Margin="0,0,0,10" Padding="3" IsReadOnly="True"/>

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Support prefix:" VerticalAlignment="Center" Margin="0,0,0,10"/>
                                <TextBox Grid.Row="3" Grid.Column="1" x:Name="SettingsSupportPrefix" Margin="0,0,0,10" Padding="3" IsReadOnly="True"/>

                                <TextBlock Grid.Row="4" Grid.Column="0" Text="Version tag prefix:" VerticalAlignment="Center"/>
                                <TextBox Grid.Row="4" Grid.Column="1" x:Name="SettingsVersionTagPrefix" Padding="3" IsReadOnly="True"/>
                            </Grid>
                        </GroupBox>

                        <TextBlock TextWrapping="Wrap" Margin="0,10,0,0" 
                                   Foreground="{DynamicResource {x:Static vsshell:VsBrushes.GrayTextKey}}">
                            <Run Text="To modify these settings, use the 'Initialize GitFlow' command from the Workflow tab or the Tools > GitFlow menu."/>
                        </TextBlock>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
